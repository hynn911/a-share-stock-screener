# 项目根目录配置
# 复制此文件为 .env 并根据实际情况修改

# 项目根目录（绝对路径）
# Windows 示例：
# PROJECT_ROOT=E:/work/cc/stock

# Linux/macOS 示例：
# PROJECT_ROOT=/home/user/projects/stock

# 数据库配置
DATABASE_URL=sqlite:///./data/stock.db

# ============================================
# 数据源配置
# ============================================

# Tushare Token（可选，用于更稳定的数据源）
# 注册获取：https://tushare.pro/
# 获取后取消下面的注释并填入 token
# TUSHARE_TOKEN=your_token_here

# 离线模式（1=启用，0=禁用）
# 启用后优先使用本地缓存数据
STOCK_APP_OFFLINE_MODE=0

# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO
